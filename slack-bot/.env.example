# FeedbackFlow Slack Bot Environment Configuration
# Copy this to .env and fill in your values

# Slack App Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_VERIFICATION_TOKEN=your-verification-token-here

# Socket Mode (recommended for development)
SLACK_SOCKET_MODE=true
SLACK_APP_TOKEN=xapp-your-app-token-here

# Server Configuration
PORT=3000

# FeedbackFlow API Configuration
FEEDBACKFLOW_API_BASE=https://your-feedbackflow-functions.azurewebsites.net/api
FEEDBACKFLOW_API_KEY=your-function-key-here

# Logging Configuration
LOG_LEVEL=info
